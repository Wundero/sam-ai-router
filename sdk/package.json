{
  "name": "@wundero/ai-router",
  "version": "1.0.0",
  "description": "Sam AI router provider for the Vercel AI SDK",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wundero/sam-ai-router"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "import": "./dist/v2.js"
    },
    "./v3": {
      "types": "./dist/v3.d.ts",
      "import": "./dist/v3.js"
    },
    "./v4": {
      "types": "./dist/v4.d.ts",
      "import": "./dist/v4.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun run build.ts",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/provider": "^4.0.10",
    "@ai-sdk/provider-utils": "^5.0.36",
    "workers-ai-provider": "^4.0.0"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.0"
  }
}
